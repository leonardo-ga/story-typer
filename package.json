{
  "name": "story-typer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/metrics.test.mjs tests/stories.test.mjs tests/interactions.test.tsx",
    "format": "prettier --write src tests readme.md package.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
